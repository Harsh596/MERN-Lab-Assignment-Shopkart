# Dependency directories
node_modules/
backend/node_modules/
frontend/*/node_modules/
frontend/vite-project/node_modules/

# Environment and sensitive credential files (CRITICAL: Do NOT push secrets to GitHub)
.env
.env.*
*.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local
backend/.env
frontend/*/.env
frontend/*/.env.local

# Allow example files so others know what environment variables to configure
!.env.example
!backend/.env.example
!frontend/*/.env.example

# Build outputs
dist/
dist-ssr/
frontend/*/dist/
frontend/vite-project/dist/
build/

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor & IDE directories
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

