# Server Port
PORT=5001

# MongoDB Atlas Connection String
# Replace <username>, <password>, and <cluster> with your Atlas cluster details
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/shopkart?retryWrites=true&w=majority

# JWT Secret for Session/Auth Tokens
JWT_SECRET=your_jwt_secret_key_here

# Razorpay Test Mode Credentials
# Obtain from Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Frontend Client URL (for CORS allowance)
CLIENT_URL=http://localhost:5173

# Environment (development | production)
NODE_ENV=development
